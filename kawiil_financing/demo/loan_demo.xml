<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Assignment 2.04: sample loan applications.

        noupdate="1" tells Odoo to create these records once and then leave
        them alone. Without it, upgrading the module would overwrite any edit
        you made to them in the interface. The flip side: records you add here
        later only appear on a fresh install (-i), not on an update (-u).

        Everything in a demo file loads only when the database was created
        with demo data enabled. That is also where base.res_partner_1 comes
        from, so the two go together.
    -->
    <data noupdate="1">

        <record id="loan_application_demo_1" model="loan.application">
            <!-- The DEMO in the reference is on purpose. From 3.07 on, new
                 applications draw their reference from a sequence,
                 LOAN/2026/001 and up. Demo records using that same pattern
                 would collide with the first real one. -->
            <field name="name">LOAN/DEMO/001</field>
            <!-- ref looks up another record by its external identifier and
                 stores that record's database id. Never hardcode a number:
                 ids differ from one database to the next. -->
            <field name="partner_id" ref="base.res_partner_1"/>
            <field name="product_id" ref="product.product_product_4"/>
            <!-- A plain date, written the way the database stores it. -->
            <field name="date_applied">2026-01-15</field>
            <field name="loan_amount">12500.00</field>
            <field name="down_payment">2500.00</field>
            <field name="loan_term">48</field>
            <field name="interest_rate">7.50</field>
            <field name="state">sent</field>

            <!--
                ! Assignment 3.01: leave this commented until you reach 3.01.
                ! loan_amount is computed from then on, so delete the
                ! loan_amount line above and give the loan its principal
                ! instead. 15000 minus the 2500 down payment gives back the
                ! same 12500.

            <field name="principal_amount">15000.00</field>

                ! Do the same on loans 2 and 3. Assignment 3.02 adds a check
                ! that the principal is above zero and above the down payment,
                ! and a demo record breaking either rule stops the install.
            -->
        </record>

        <!-- Loans 2 and 3 compute their dates, so they never drift out of
             date as the course runs. (4, id) links an existing record, the
             form Odoo's own data files use for 2many fields. -->
        <record id="loan_application_demo_2" model="loan.application">
            <field name="name">LOAN/DEMO/002</field>
            <field name="partner_id" ref="base.res_partner_2"/>
            <field name="product_id" ref="product.product_product_4"/>
            <field name="date_applied"
                   eval="(DateTime.now() - relativedelta(months=5)).strftime('%Y-%m-%d')"/>
            <field name="loan_amount">8000.00</field>
            <field name="down_payment">1500.00</field>
            <field name="loan_term">36</field>
            <field name="interest_rate">6.50</field>
            <field name="state">draft</field>
            <field name="cosigner_ids" eval="[(4, ref('base.res_partner_4'))]"/>
        </record>

        <record id="loan_application_demo_3" model="loan.application">
            <field name="name">LOAN/DEMO/003</field>
            <field name="partner_id" ref="base.res_partner_3"/>
            <field name="product_id" ref="product.product_product_4"/>
            <field name="date_applied"
                   eval="(DateTime.now() - relativedelta(months=2)).strftime('%Y-%m-%d')"/>
            <field name="loan_amount">15000.00</field>
            <field name="down_payment">3000.00</field>
            <field name="loan_term">60</field>
            <field name="interest_rate">8.00</field>
            <field name="state">approved</field>
            <field name="cosigner_ids" eval="[(4, ref('base.res_partner_4'))]"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Assignment 2.09: tag views.

        The pair any configuration table needs: a view that says how to
        display it, and an action that opens that view.
    -->

    <record id="loan_application_tag_view_list" model="ir.ui.view">
        <!-- A technical label, by convention model name plus view type. -->
        <field name="name">loan.application.tag.view.list</field>
        <field name="model">loan.application.tag</field>
        <!-- arch is the view itself. type="xml" tells Odoo to store the tags
             below as markup rather than escape them into text. -->
        <field name="arch" type="xml">
            <!-- editable="bottom" turns the list into a grid you type
                 straight into, with new rows appearing at the end. Without it
                 every tag would need its own form view, which for two columns
                 is more clicking than typing. -->
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="loan_application_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">loan.application.tag</field>
        <field name="view_mode">list</field>
    </record>

</odoo>

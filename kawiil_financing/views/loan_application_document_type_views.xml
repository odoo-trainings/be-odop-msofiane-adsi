<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Assignment 2.09: document type views. -->

    <record id="loan_application_document_type_view_list" model="ir.ui.view">
        <field name="name">loan.application.document.type.view.list</field>
        <field name="model">loan.application.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="name"/>
                <field name="is_required"/>
            </list>
        </field>
    </record>

    <record id="loan_application_document_type_action" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">loan.application.document.type</field>
        <field name="view_mode">list</field>
    </record>

</odoo>

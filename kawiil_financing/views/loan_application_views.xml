<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Loan application: action, views and the "Assign to Me" server action.

        Built up across several assignments:
          2.06  the action, opening Odoo's automatic views
          2.08  real list, form and search views, replacing those
          2.09  the tags field and the Compliance Checklist page
          3.01  the computed amounts and the customer's contact details
          3.03  the workflow buttons and dates
          3.04  the "Assign to Me" server action
          4.02  the chatter

        A view is a record like any other. The layout lives in the arch field
        as markup, and Odoo picks the highest priority view of each type for a
        model unless an action names one explicitly.

        XML comments cannot be nested, so the changes later assignments make
        to the form are not inside it. Each one sits in its own comment right
        after the form, marked with "!", and says where it goes. Leave those
        exactly as they are until the assignment they name.
    -->

    <!-- Assignment 2.06: worked example -->
    <record id="loan_application_action" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <!-- list, not tree: tree was renamed in Odoo 18. -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first loan application</p>
            <p>Track motorcycle financing from the first request to the final decision.</p>
        </field>
    </record>

    <!--
        Assignment 2.08: worked example. Uncomment the record below when you
        reach 2.08: delete the two comment markers around it, nothing else.

        A Monetary column needs its currency field present to render, but
        nobody wants to see a column of identical currencies.
        column_invisible loads it without showing it.

        Bonus exercise: try widget="badge" on state, or a
        decoration-success="state == 'approved'" attribute, to make the rows
        carry meaning at a glance.
    -->
    <!--
    <record id="loan_application_view_list" model="ir.ui.view">
        <field name="name">loan.application.view.list</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <list string="Loan Applications">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="loan_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    -->

    <!--
        Assignment 2.08: worked example, and the answer to "why are my fields
        stacked vertically". Uncomment the record below when you reach 2.08.

        The nesting is what makes the columns. The outer group opens a column
        layout; each inner group becomes one column of labels and fields. A
        single group on its own gives you one column, everything stacked.

        A notebook holds the detail. Anything a user needs at a glance goes on
        the sheet above it; everything else earns a page.

        Three things worth reading closely as you uncomment it:

          header        the strip above the sheet. A statusbar shows the
                        workflow as a row of stages instead of a dropdown.
          oe_title      the large heading area at the top left of a sheet,
                        where the record's identity goes.
          cosigner_ids  many2many_tags draws each co-signer as a pill, in the
                        same column as the customer they stand behind.
    -->
    <!--
    <record id="loan_application_view_form" model="ir.ui.view">
        <field name="name">loan.application.view.form</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <form string="Loan Application">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. LOAN/2026/001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cosigner_ids" widget="many2many_tags"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="date_applied"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Financials">
                            <group>
                                <group>
                                    <field name="currency_id" invisible="1"/>

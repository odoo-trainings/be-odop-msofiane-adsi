<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Loan application: action, views and the "Assign to Me" server action.

        Built up across several assignments:
          2.06  the action, opening Odoo's automatic views
          2.08  real list, form and search views, replacing those
          2.09  the tags field and the Compliance Checklist page
          3.01  the computed amounts and the customer's contact details
          3.03  the workflow buttons and dates
          3.04  the "Assign to Me" server action
          4.02  the chatter

        A view is a record like any other. The layout lives in the arch field
        as markup, and Odoo picks the highest priority view of each type for a
        model unless an action names one explicitly.

        XML comments cannot be nested, so the changes later assignments make
        to the form are not inside it. Each one sits in its own comment right
        after the form, marked with "!", and says where it goes. Leave those
        exactly as they are until the assignment they name.
    -->

    <!-- Assignment 2.06 -->
    <record id="loan_application_action" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loan.application</field>
        <!-- list, not tree: tree was renamed in Odoo 18. -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first loan application</p>
            <p>Track motorcycle financing from the first request to the final decision.</p>
        </field>
    </record>

    <!-- Assignment 2.08. currency_id is loaded but hidden: the Monetary
         column needs it to render, nobody needs to read it. -->
    <record id="loan_application_view_list" model="ir.ui.view">
        <field name="name">loan.application.view.list</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <list string="Loan Applications">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="loan_amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Assignment 2.08. The outer group opens a column layout and each
         inner group becomes one column, a single group would stack
         everything. What a user needs at a glance goes on the sheet, the
         rest earns a notebook page. -->
    <record id="loan_application_view_form" model="ir.ui.view">
        <field name="name">loan.application.view.form</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <form string="Loan Application">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. LOAN/2026/001"/>
                        </h1>
                    </div>
                    <!-- Assignment 2.09: color_field names the field holding
                         each tag's palette index. -->
                    <field name="tag_ids" widget="many2many_tags"
                           options="{'color_field': 'color'}"
                           placeholder="Tags..."/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cosigner_ids" widget="many2many_tags"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="date_applied"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Financials">
                            <group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="loan_amount"/>
                                    <field name="down_payment"/>
                                </group>
                                <group>
                                    <field name="loan_term"/>
                                    <field name="interest_rate"/>
                                </group>
                            </group>
                        </page>
                        <!-- Assignment 2.09: an embedded editable list, so
                             paperwork is added without leaving the loan. -->
                        <page string="Compliance Checklist">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="type_id"/>
                                    <field name="name"/>
                                    <field name="attachment_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" placeholder="Add internal notes here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        ! Assignment 3.01: leave this commented until you reach 3.01.
        ! Then make two changes to the form above.

        1. The customer's contact details, straight under partner_id. They are
           related fields, read-only, filled in the moment a customer is
           picked:

               <field name="email"/>
               <field name="phone"/>

        2. The amounts in the Financials page. It replaces the loan_amount and
           down_payment lines there; delete those then. principal_amount is
           typed in, loan_amount is worked out from it. widget="monetary"
           shows the currency symbol, and it needs the invisible currency_id
           in the same group, which is already there:

               <field name="principal_amount" widget="monetary"/>
               <field name="down_payment" widget="monetary"/>
               <field name="loan_amount" widget="monetary"/>
    -->

    <!--
        ! Assignment 3.03: leave this commented until you reach 3.03.
        ! Then make three changes to the form above.

        1. The workflow buttons, in the header before the statusbar. A
           type="object" button calls the Python method named in name= on the
           record in the form. invisible takes a Python expression over the
           record's fields, so each button only shows in the state it starts
           from. The first one is written out:

               <button name="action_submit" type="object" string="Submit"
                       class="btn-primary" invisible="state != 'draft'"/>

           Add Approve (action_approve_loan) and Reject (action_reject_loan)
           the same way, both visible only while state is 'sent'. Give Approve
           class="btn-primary" and Reject class="btn-secondary".

        2. The decision dates, in the second column under date_applied, each
           hidden until it has a value:

               <field name="date_approved" invisible="not date_approved"/>
               <field name="date_rejected" invisible="not date_rejected"/>

        3. Approve and reject buttons on every checklist line, after the state
           column of the document_ids list. An icon button has no text, so it
           needs a title for the tooltip and for screen readers:

               <button name="action_approve_document" type="object"
                       icon="fa-check" title="Approve"/>
               <button name="action_reject_document" type="object"
                       icon="fa-times" title="Reject"/>

        Do not use attrs="{'invisible': ...}" from older Odoo versions. It
        was removed, and the view will not load with it.
    -->

    <!--
        ! Assignment 4.02: leave this commented until you reach 4.02.
        ! Then add the chatter to the form above, straight after </sheet> and
        ! still inside </form>. Inside the sheet it would be squeezed into the
        ! form's column; outside, Odoo gives it its own panel:

               <chatter/>
    -->

    <!-- Assignment 2.08. Filters in one block combine with OR, a separator
         starts a new block combined with AND, so Draft plus My Applications
         shows records that are both. -->
    <record id="loan_application_view_search" model="ir.ui.view">
        <field name="name">loan.application.view.search</field>
        <field name="model">loan.application</field>
        <field name="arch" type="xml">
            <search string="Loan Applications">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_my_applications" string="My Applications"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_user" string="Salesperson"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--
        TODO (assignment 3.04): the "Assign to Me" server action.

        id loan_application_action_assign_to_me, model ir.actions.server,
        with these fields:

            name                "Assign to Me", the label in the Actions menu
            model_id            ref="model_loan_application", the model the
                                code runs on
            binding_model_id    ref="model_loan_application" again. This is
                                what puts the action in the Actions menu at
                                all; without it the action exists but nothing
                                shows it.
            binding_view_types  list, so it appears when records are selected
                                in the list view and not on the form
            state               code, meaning the action runs Python
            code                records.action_assign_to_me()

        records is the selection the user made, however many records that is.
        The method does the work, the action only calls it: logic kept in the
        model can be tested and reused, logic typed into a code field cannot.

        No view change is needed. Odoo adds an action with a binding_model_id
        to the Actions menu by itself.
    -->

</odoo>

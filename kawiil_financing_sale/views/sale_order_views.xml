<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_kawiil_financing_sale" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.kawiil_financing_sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Only on a confirmed order, and only until its loan exists. -->
            <xpath expr="//header" position="inside">
                <button name="action_create_loan" type="object" string="Create Loan"
                        invisible="state != 'sale' or loan_application_count"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_loan_applications" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not loan_application_count">
                    <field name="loan_application_count" widget="statinfo" string="Loans"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

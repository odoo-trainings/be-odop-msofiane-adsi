<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Next to "Sales" and "Purchase", the other yes/no options on a
         product. -->
    <record id="product_template_form_view_inherit_kawiil_financing_sale" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.kawiil_financing_sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span name="financeable_option" class="d-inline-flex">
                    <field name="is_financeable" widget="boolean_checkbox" class="w-auto"/>
                    <label for="is_financeable"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
